// Who gets a payment reminder today, and what it says. Plain logic with no Google APIs,
// so the same code runs in tests, in the web simulator and inside Apps Script.

const DEFAULT_SCHEDULE = { before: 3, after: [0, 3, 7], thenEvery: 7, maxAfter: 45 };

const DEFAULT_TEMPLATES = {
  en: {
    upcoming: "Hi {name},\n\nA quick reminder that ₹{amount} is due on {due}.{paylink}\n\nIf you've already paid, please ignore this.\n\nThanks,\n{business}",
    due: "Hi {name},\n\n₹{amount} is due today ({due}).{paylink}\n\nIf you've already paid, please reply with the reference and we'll update our records.\n\nThanks,\n{business}",
    overdue: "Hi {name},\n\n₹{amount} was due on {due}, {days} days ago, and we haven't received it yet.{paylink}\n\nIf there's a problem, just reply to this email and we'll work it out.\n\nThanks,\n{business}",
  },
  hi: {
    upcoming: "नमस्ते {name},\n\nयाद दिला दें कि ₹{amount} की राशि {due} को देय है।{paylink}\n\nअगर आप भुगतान कर चुके हैं, तो कृपया इसे नज़रअंदाज़ करें।\n\nधन्यवाद,\n{business}",
    due: "नमस्ते {name},\n\n₹{amount} की राशि आज ({due}) देय है।{paylink}\n\nअगर भुगतान हो चुका है, तो कृपया रेफ़रेंस नंबर भेज दें ताकि हम रिकॉर्ड अपडेट कर सकें।\n\nधन्यवाद,\n{business}",
    overdue: "नमस्ते {name},\n\n₹{amount} की राशि {due} को देय थी, यानी {days} दिन पहले, और अभी तक नहीं मिली है।{paylink}\n\nकोई परेशानी हो तो इस ईमेल का जवाब दें, हम मिलकर हल निकाल लेंगे।\n\nधन्यवाद,\n{business}",
  },
};

const SUBJECT = {
  en: { upcoming: "Payment reminder: ₹{amount} due on {due}", due: "Payment due today: ₹{amount}", overdue: "Overdue: ₹{amount} (due {due})" },
  hi: { upcoming: "भुगतान रिमाइंडर: ₹{amount}, देय तिथि {due}", due: "आज देय: ₹{amount}", overdue: "बकाया: ₹{amount} (देय तिथि {due})" },
};

const PLACEHOLDERS = ["{name}", "{amount}", "{due}", "{days}", "{paylink}", "{business}"];

const DAY = 86400000;
const daysBetween = (from, to) => Math.round((Date.parse(to) - Date.parse(from)) / DAY);
const addDays = (d, n) => new Date(Date.parse(d) + n * DAY).toISOString().slice(0, 10);

function prettyDate(d, lang = "en") {
  const dt = new Date(d + "T00:00:00Z");
  return dt.toLocaleDateString(lang === "hi" ? "hi-IN" : "en-IN", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
}

const money = (n) => n.toLocaleString("en-IN", { maximumFractionDigits: 2 });
const isEmail = (s) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s.trim());

/** Which kind of reminder (if any) the schedule calls for on a given day. */
function kindFor(daysLate, s) {
  if (daysLate === -s.before) return "upcoming";
  if (daysLate < 0) return null;
  if (daysLate > s.maxAfter) return null;
  if (s.after.includes(daysLate)) return daysLate === 0 ? "due" : "overdue";
  const last = Math.max(...s.after);
  if (s.thenEvery > 0 && daysLate > last && (daysLate - last) % s.thenEvery === 0) return "overdue";
  return null;
}

function fill(t, e, daysLate, set) {
  const link = set.payLink.trim() ? (e.lang === "hi" ? `\n\nभुगतान यहाँ करें: ${set.payLink.trim()}` : `\n\nYou can pay here: ${set.payLink.trim()}`) : "";
  return t
    .replaceAll("{name}", e.name.split(" ")[0] || e.name)
    .replaceAll("{amount}", money(e.amount))
    .replaceAll("{due}", prettyDate(e.due, e.lang))
    .replaceAll("{days}", String(daysLate))
    .replaceAll("{paylink}", link)
    .replaceAll("{business}", set.business);
}

/**
 * The whole decision for one day. Returns reminders to send and the rows skipped, with why.
 * A row never gets two emails on the same day, and "Paid" (in any case) always stops it.
 */
function plan(entries, today, set) {
  const send = [];
  const skip = [];
  for (const e of entries) {
    if (/^paid$/i.test(e.status.trim())) continue;
    if (!e.name.trim() && !e.email.trim()) continue;
    if (!isEmail(e.email)) { skip.push({ entry: e, reason: `"${e.email}" isn't a valid email` }); continue; }
    if (!(e.amount > 0)) { skip.push({ entry: e, reason: "amount is missing or zero" }); continue; }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(e.due) || Number.isNaN(Date.parse(e.due))) { skip.push({ entry: e, reason: "due date is missing or unreadable" }); continue; }
    if (e.lastReminded === today) continue;
    const late = daysBetween(e.due, today);
    const kind = kindFor(late, set.schedule);
    if (!kind) continue;
    const t = set.templates[e.lang] ?? set.templates.en;
    send.push({ entry: e, kind, daysLate: late, subject: fill(SUBJECT[e.lang][kind], e, late, set), body: fill(t[kind], e, late, set) });
  }
  return { send, skip };
}

/** Checks a custom template: placeholders must be known, and {amount} and {due} must be there. */
function templateProblems(t) {
  const p = [];
  for (const m of t.match(/\{[^}]*\}/g) ?? []) if (!PLACEHOLDERS.includes(m)) p.push(`Unknown placeholder ${m}. Use ${PLACEHOLDERS.join(", ")}.`);
  for (const need of ["{amount}", "{due}"]) if (!t.includes(need)) p.push(`Needs ${need}, so the person knows what and when.`);
  if (t.length > 1200) p.push("Too long. Keep it under 1,200 characters.");
  return p;
}

/** Reads a sheet's values (header row first). Accepts Date objects from Sheets or text dates. */
function readSheet(values) {
  const head = (values[0] ?? []).map((h) => String(h).trim().toLowerCase());
  const col = (names) => head.findIndex((h) => names.includes(h));
  const c = {
    name: col(["name", "student", "customer", "client"]),
    email: col(["email", "e-mail", "email id"]),
    amount: col(["amount", "fee", "amount due", "balance"]),
    due: col(["due", "due date", "due on"]),
    status: col(["status", "paid?", "payment status"]),
    last: col(["last reminded", "last reminder", "reminded on"]),
    lang: col(["language", "lang"]),
  };
  for (const [k, v] of Object.entries(c)) if (v < 0 && !["last", "lang", "status"].includes(k)) throw new Error(`The sheet needs a "${k}" column. Found: ${values[0]?.join(", ")}`);
  return values.slice(1).map((r, i) => ({
    row: i + 2,
    name: String(r[c.name] ?? "").trim(),
    email: String(r[c.email] ?? "").trim(),
    amount: Number(String(r[c.amount] ?? "").replace(/[₹,\s]/g, "")) || 0,
    due: toIso(r[c.due]),
    status: c.status >= 0 ? String(r[c.status] ?? "") : "",
    lastReminded: c.last >= 0 ? toIso(r[c.last]) : "",
    lang: c.lang >= 0 && /^(hi|hindi|हिंदी)$/i.test(String(r[c.lang] ?? "").trim()) ? "hi" : "en",
  }));
}

function toIso(v) {
  if (v instanceof Date && !Number.isNaN(v.getTime())) {
    // Sheets gives local-midnight dates; use the local calendar date.
    return `${v.getFullYear()}-${String(v.getMonth() + 1).padStart(2, "0")}-${String(v.getDate()).padStart(2, "0")}`;
  }
  const s = String(v ?? "").trim();
  if (!s) return "";
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  const m = s.match(/^(\d{1,2})[-/.](\d{1,2})[-/.](\d{4})$/);
  return m ? `${m[3]}-${m[2].padStart(2, "0")}-${m[1].padStart(2, "0")}` : s;
}

// ---- Google Sheets side. Everything above this line is generated from src/core/reminders.ts. ----

const SHEET = "Payments";
const LOG = "Reminder log";
const SETTINGS = "Settings";
const HEADERS = ["Name", "Email", "Amount", "Due date", "Status", "Last reminded", "Language"];

/** Adds a "Reminders" menu when the sheet opens. */
function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu("Reminders")
    .addItem("Preview today's reminders", "previewReminders")
    .addItem("Send today's reminders now", "sendReminders")
    .addSeparator()
    .addItem("Set up sheets and daily 9 AM run", "setup")
    .addItem("Stop the daily run", "removeTrigger")
    .addToUi();
}

/** Creates the three sheets if they're missing and installs one daily trigger. Safe to run twice. */
function setup() {
  const ss = SpreadsheetApp.getActive();
  let sh = ss.getSheetByName(SHEET);
  if (!sh) {
    sh = ss.insertSheet(SHEET);
    sh.getRange(1, 1, 1, HEADERS.length).setValues([HEADERS]).setFontWeight("bold");
    sh.setFrozenRows(1);
    sh.getRange("D:D").setNumberFormat("dd-mm-yyyy");
    sh.getRange("F:F").setNumberFormat("dd-mm-yyyy");
    sh.getRange("E2:E").setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(["Unpaid", "Paid"], true).build());
  }
  let st = ss.getSheetByName(SETTINGS);
  if (!st) {
    st = ss.insertSheet(SETTINGS);
    st.getRange(1, 1, 6, 2).setValues([
      ["Business name", ss.getName()],
      ["Payment link (UPI or page, optional)", ""],
      ["First reminder, days before due", DEFAULT_SCHEDULE.before],
      ["Follow-ups, days after due (comma separated)", DEFAULT_SCHEDULE.after.join(", ")],
      ["Then repeat every N days (0 = stop)", DEFAULT_SCHEDULE.thenEvery],
      ["Stop after this many days late", DEFAULT_SCHEDULE.maxAfter],
    ]);
    st.setColumnWidth(1, 320);
  }
  if (!ss.getSheetByName(LOG)) {
    const lg = ss.insertSheet(LOG);
    lg.getRange(1, 1, 1, 6).setValues([["Sent at", "Row", "Name", "Email", "Type", "Subject"]]).setFontWeight("bold");
    lg.setFrozenRows(1);
  }
  removeTrigger();
  ScriptApp.newTrigger("sendReminders").timeBased().everyDays(1).atHour(9).create();
  SpreadsheetApp.getUi().alert("Done. Reminders will go out every day around 9 AM. Use the Reminders menu to preview or send now.");
}

function removeTrigger() {
  for (const t of ScriptApp.getProjectTriggers()) if (t.getHandlerFunction() === "sendReminders") ScriptApp.deleteTrigger(t);
}

function readSettings_() {
  const st = SpreadsheetApp.getActive().getSheetByName(SETTINGS);
  const v = st ? st.getRange(1, 2, 6, 1).getValues().map((r) => r[0]) : [];
  const n = (x, d) => (x === "" || x === null || x === undefined || Number.isNaN(Number(x)) ? d : Number(x));
  const after = String(v[3] ?? "").split(/[,\s]+/).filter(Boolean).map(Number).filter((x) => x >= 0);
  return {
    business: String(v[0] || SpreadsheetApp.getActive().getName()),
    payLink: String(v[1] || ""),
    schedule: {
      before: n(v[2], DEFAULT_SCHEDULE.before),
      after: after.length ? after : DEFAULT_SCHEDULE.after,
      thenEvery: n(v[4], DEFAULT_SCHEDULE.thenEvery),
      maxAfter: n(v[5], DEFAULT_SCHEDULE.maxAfter),
    },
    templates: DEFAULT_TEMPLATES,
  };
}

function today_() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd");
}

function todaysPlan_() {
  const sh = SpreadsheetApp.getActive().getSheetByName(SHEET);
  if (!sh) throw new Error('No "' + SHEET + '" sheet. Run Reminders > Set up first.');
  const entries = readSheet(sh.getDataRange().getValues());
  return { sh, result: plan(entries, today_(), readSettings_()) };
}

function previewReminders() {
  const { result } = todaysPlan_();
  const lines = result.send.map((r) => "• " + r.entry.name + " <" + r.entry.email + ">: " + r.subject);
  const skips = result.skip.map((s) => "• Row " + s.entry.row + " skipped: " + s.reason);
  SpreadsheetApp.getUi().alert((lines.length ? "Would send " + lines.length + " today:\n" + lines.join("\n") : "Nothing to send today.") + (skips.length ? "\n\n" + skips.join("\n") : ""));
}

/** The daily job. Sends, then writes "Last reminded" and a log line for each one. */
function sendReminders() {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) return;
  try {
    const { sh, result } = todaysPlan_();
    const head = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map((h) => String(h).trim().toLowerCase());
    let lastCol = head.indexOf("last reminded") + 1;
    if (!lastCol) {
      lastCol = head.length + 1;
      sh.getRange(1, lastCol).setValue("Last reminded").setFontWeight("bold");
    }
    const log = SpreadsheetApp.getActive().getSheetByName(LOG);
    const today = today_();
    let quota = MailApp.getRemainingDailyQuota();
    for (const r of result.send) {
      if (quota <= 0) break;
      MailApp.sendEmail({ to: r.entry.email, subject: r.subject, body: r.body, name: readSettings_().business });
      quota--;
      sh.getRange(r.entry.row, lastCol).setValue(today);
      if (log) log.appendRow([new Date(), r.entry.row, r.entry.name, r.entry.email, r.kind, r.subject]);
    }
  } finally {
    lock.releaseLock();
  }
}
